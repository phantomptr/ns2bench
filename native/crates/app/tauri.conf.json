{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NS2Bench",
  "version": "0.0.16",
  "identifier": "io.github.phantomptr.ns2bench",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "NS2Bench",
        "width": 1480,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "closable": true,
        "minimizable": true,
        "maximizable": true,
        "maximized": false,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "See, hear and drive a game console by hand or by AI agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ],
        "recommends": [
          "openssh-client",
          "pkexec | policykit-1",
          "tesseract-ocr"
        ]
      }
    },
    "publisher": "PhantomPtr",
    "copyright": "Copyright \u00a9 2026 PhantomPtr. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://ns2bench.phantomptr.com"
  }
}
